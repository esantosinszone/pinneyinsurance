---
// Official Pinney logo (public/logo.svg, drawn in accent-600 #0e8fcf).
// `tone="light"` renders it white for dark backgrounds via a CSS filter,
// so there is a single source file.
interface Props { class?: string; tone?: 'light' | 'dark'; }
const { class: cls = '', tone = 'dark' } = Astro.props;
---
<a href="/" class:list={['inline-flex items-center rounded-md', cls]} aria-label="Pinney Insurance, Life Insurance Division — partner home">
  <img
    src="/logo.svg"
    alt=""
    width="549"
    height="77"
    class:list={['h-7 w-auto sm:h-8', tone === 'light' && 'brightness-0 invert']}
    decoding="async"
  />
</a>
