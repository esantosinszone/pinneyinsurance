---
import { Icon } from 'astro-icon/components';
import { contact } from '../../data/site';

// Decision tree from the original submission wizard. Questions have `o` (options);
// results have `r: true` plus either a form CTA or an email CTA.
const steps = {
  start: { q: 'Do you want to handle the sale yourself?', o: [{ t: 'No, refer it to Pinney', n: 'annuity' }, { t: 'Yes, I want to sell it', n: 'licensed' }] },
  annuity: { q: 'Is this an annuity?', o: [{ t: 'Yes', n: 'annuityEmail' }, { t: 'No', n: 'refer' }] },
  licensed: { q: "Are you licensed in the client's state?", o: [{ t: 'Yes', n: 'appointment' }, { t: 'No', n: 'refer' }] },
  appointment: {
    q: 'Are you appointed with the carrier?',
    h: `Not appointed yet? Email ${contact.contracting} to start — about a two-week turnaround.`,
    o: [{ t: 'Yes', n: 'product' }, { t: 'No', n: 'getappointed' }],
  },
  product: { q: 'Is product-specific training required?', h: 'Typically no for Term. Usually yes for Annuity, LTC, and IUL.', o: [{ t: 'No', n: 'sales' }, { t: 'Yes', n: 'training' }] },
  sales: { q: 'Do you want to write the policy yourself?', o: [{ t: 'Yes', n: 'sell' }, { t: 'Not really', n: 'ticket' }] },
  getappointed: {
    q: 'Get appointed first, then you can sell it yourself.',
    h: `Email ${contact.contracting} to start. About a two-week turnaround.`,
    o: [{ t: 'My client needs the policy now', n: 'refer' }, { t: "I'll get appointed and sell it later", n: 'appointLater' }],
  },
  refer: { r: true, tag: 'Option 1 — Refer & Earn', q: 'Refer it. You refer, we sell.', h: '50/50 split. We handle the needs analysis, health screening, quotes, the sale, the application, case management, delivery, and placement. Submit the client on the form and we call within 24 hours.', form: true },
  ticket: { r: true, tag: 'Option 2 — App Assist', q: 'Drop the ticket. You sell, we complete the app.', h: 'You keep 100% of your normal commission. Submit the client on the form and our app team calls them to take the full application and collect every requirement.', form: true },
  sell: { r: true, tag: 'Option 3 — Self-Service', q: 'Write it yourself. You sell and complete the app.', h: 'You keep 100% of your normal commission. Start the case on the form and your brokerage manager will get you set up in Insureio.', form: true },
  training: { r: true, tag: 'Training first', q: 'Complete the product training, then submit.', h: "Once training is done your brokerage manager will help you submit in Insureio. Start the case on the form and we'll route it to them.", form: true },
  annuityEmail: { r: true, tag: 'Annuity', q: `Email your annuity request to ${contact.annuities}.`, h: 'Say whether you want it handled as a 50/50 referral.', mail: contact.annuities, subj: 'Annuity request', label: 'Email the annuity desk' },
  appointLater: { r: true, tag: 'Contracting', q: `Email ${contact.contracting} to get appointed.`, h: "About a two-week turnaround. Come back here when you're ready to submit the case.", mail: contact.contracting, subj: 'Carrier appointment request', label: 'Email contracting' },
};
---
<section class="section" id="route-finder" aria-labelledby="rf-title">
  <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5" data-reveal>
      <p class="eyebrow">Start here</p>
      <h2 id="rf-title" class="h2 mt-5 max-w-[14ch]">Not sure which way <strong>to submit?</strong></h2>
      <p class="mt-6 max-w-[46ch]">
        Answer a few questions and we'll point you at the right route — refer it to us, drop the ticket, or write it yourself. Every path ends at the same form.
      </p>
      <ol class="mt-10 space-y-4 border-t border-line pt-6 text-[0.9375rem]">
        {['Tell us how involved you want to be', 'We check licensing, appointment, and product training', 'You get the route and the link to submit'].map((t, i) => (
          <li class="flex gap-4"><span class="w-6 font-bold text-accent-600">0{i + 1}</span><span class="text-muted">{t}</span></li>
        ))}
      </ol>
    </div>

    <div class="lg:col-span-7" data-reveal style="--reveal-delay:100ms">
      <div class="relative flex min-h-[22rem] flex-col overflow-hidden rounded-[1.75rem] bg-navy p-7 text-white sm:p-10" data-wizard data-steps={JSON.stringify(steps)}>
        <div class="absolute inset-x-0 top-0 h-1 bg-white/10" aria-hidden="true">
          <div class="h-full w-[16%] bg-accent-300 transition-[width] duration-500 ease-out" data-progress></div>
        </div>
        <div data-stage aria-live="polite" class="flex flex-1 flex-col">
          <noscript><p>Turn on JavaScript to use the route finder, or <a class="link" href="#form">go straight to the form</a>.</p></noscript>
        </div>
        <div class="mt-8 flex items-center gap-2 border-t border-white/12 pt-5">
          <button type="button" class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-1.5 text-[0.8125rem] font-semibold text-white/70 transition-colors hover:bg-white/10 hover:text-white disabled:pointer-events-none disabled:opacity-30" data-back disabled>
            <Icon name="hugeicons:arrow-left-02" class="size-4" aria-hidden="true" />Back
          </button>
          <button type="button" class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-1.5 text-[0.8125rem] font-semibold text-white/70 transition-colors hover:bg-white/10 hover:text-white" data-reset>
            <Icon name="hugeicons:refresh" class="size-4" aria-hidden="true" />Start over
          </button>
          <span class="ml-auto whitespace-nowrap text-[0.75rem] font-semibold tracking-[0.1em] text-white/50 uppercase" data-count></span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { onPage } from '../../scripts/lifecycle';

  // Re-initialised on every page load / client-side navigation (ClientRouter).
  onPage(() => {
    type Opt = { t: string; n: string };
    type Step = { q: string; h?: string; o?: Opt[]; r?: boolean; tag?: string; form?: boolean; mail?: string; subj?: string; label?: string };

    const box = document.querySelector<HTMLElement>('[data-wizard]');
    if (box) {
      const steps: Record<string, Step> = JSON.parse(box.dataset.steps!);
      const stage = box.querySelector<HTMLElement>('[data-stage]')!;
      const back = box.querySelector<HTMLButtonElement>('[data-back]')!;
      const progress = box.querySelector<HTMLElement>('[data-progress]')!;
      const count = box.querySelector<HTMLElement>('[data-count]')!;
      let hist = ['start'];

      const el = (tag: string, cls: string, text?: string) => {
        const n = document.createElement(tag);
        n.className = cls;
        if (text) n.textContent = text;
        return n;
      };
      const arrow = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12H4M15 17l5-5-5-5"/></svg>';

      const render = (focus = false) => {
        const s = steps[hist[hist.length - 1]];
        stage.replaceChildren();
        const wrap = el('div', 'wiz-step flex flex-1 flex-col');
        wrap.append(el('p', `label ${s.r ? '!text-accent-300' : '!text-white/60'}`, s.tag ?? `Question ${hist.length}`));
        const h = el('h3', 'mt-4 max-w-[26ch] text-[clamp(1.375rem,2.6vw,1.875rem)] leading-tight font-light tracking-tight text-white', s.q);
        h.tabIndex = -1;
        wrap.append(h);
        if (s.h) wrap.append(el('p', 'mt-4 max-w-[56ch] text-[0.9375rem] text-white/75', s.h));

        const actions = el('div', 'mt-8 flex flex-wrap gap-3');
        if (!s.r && s.o) {
          s.o.forEach((o) => {
            const b = el('button', 'btn border border-white/25 text-white hover:border-white hover:bg-white/10', o.t) as HTMLButtonElement;
            b.type = 'button';
            b.addEventListener('click', () => {
              hist.push(o.n);
              render(true);
            });
            actions.append(b);
          });
        } else {
          const a = el('a', 'btn btn-light') as HTMLAnchorElement;
          if (s.form) {
            a.href = '#form';
            a.textContent = 'Submit the client ';
          } else {
            a.href = `mailto:${s.mail}?subject=${encodeURIComponent(s.subj ?? '')}`;
            a.textContent = `${s.label} `;
          }
          a.insertAdjacentHTML('beforeend', arrow);
          const other = el('button', 'btn btn-ghost-dark', 'Other ways in') as HTMLButtonElement;
          other.type = 'button';
          other.setAttribute('data-get-started', '');
          actions.append(a, other);
        }
        wrap.append(actions);
        stage.append(wrap);

        back.disabled = hist.length < 2;
        const depth = s.r ? 1 : Math.min(0.85, hist.length / 6);
        progress.style.width = `${Math.max(0.16, depth) * 100}%`;
        count.textContent = s.r ? 'Your route' : `Step ${hist.length}`;
        if (focus) h.focus({ preventScroll: true });
      };

      back.addEventListener('click', () => {
        if (hist.length > 1) hist.pop();
        render(true);
      });
      box.querySelector('[data-reset]')!.addEventListener('click', () => {
        hist = ['start'];
        render(true);
      });
      render();
    }
  });
</script>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .wiz-step { animation: wiz-in 320ms var(--ease-out); }
    @keyframes wiz-in { from { opacity: 0; transform: translateX(10px); } }
  }
  .wiz-step h3:focus { outline: none; }
</style>
