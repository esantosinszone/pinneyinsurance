---
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import SectionHeader from '../ui/SectionHeader.astro';
import { routes, routeTasks, selfServiceIncludes } from '../../data/home';
import { img } from '../../data/site';
---
<section class="section" id="routes" aria-labelledby="routes-title">
  <div class="container-site">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <SectionHeader
        class="lg:col-span-7"
        id="routes-title"
        eyebrow="Three routes, one back office"
        title="Pick how involved <strong>you want to be.</strong>"
      />
      <p class="lead lg:col-span-5" data-reveal>
        Everything after the hand-off. The carriers, underwriting desk, and case managers are the same in all three.
      </p>
    </div>

    <!-- responsibility matrix: one table instead of three repeated cards -->
    <div class="mt-14 overflow-x-auto" data-reveal>
      <table class="w-full border-collapse text-left">
        <caption class="sr-only">Who handles each part of the case under each route</caption>
        <thead>
          <tr class="align-bottom">
            <th scope="col" class="w-[38%] pr-3 pb-6 align-bottom sm:w-[34%]">
              <span class="flex flex-wrap gap-x-5 gap-y-2 text-[0.8125rem] font-semibold text-muted">
                <span class="inline-flex items-center gap-2"><span class="size-2.5 rounded-full bg-accent-600"></span>Pinney does it</span>
                <span class="inline-flex items-center gap-2"><span class="size-2.5 rounded-full border-2 border-navy"></span>You do it</span>
              </span>
            </th>
            {routes.map((r) => (
              <th scope="col" class:list={['px-2 pb-6 align-bottom sm:px-3 md:px-6', r.n === 1 && 'bg-accent-50 rounded-t-2xl pt-6']}>
                <span class="label block">Option {r.n}</span>
                <span class="mt-1 block text-[0.9375rem] leading-tight font-semibold text-navy sm:text-[1.125rem] md:text-[1.375rem]">{r.name}</span>
                <span class="mt-1.5 hidden text-[0.875rem] font-normal text-muted md:block">
                  {r.flow[0]} <Icon name="hugeicons:arrow-right-02" class="inline size-3.5 align-[-2px]" aria-label="then" /> {r.flow[1]}
                </span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {routeTasks.map((t) => (
            <tr class="border-t border-line">
              <th scope="row" class="py-3.5 pr-3 text-[0.875rem] font-normal text-body sm:text-[0.9375rem]">{t.task}</th>
              {t.who.map((w, i) => (
                <td class:list={['px-2 py-3.5 sm:px-3 md:px-6', i === 0 && 'bg-accent-50']}>
                  {w === 'p' ? (
                    <span class="inline-flex items-center gap-2 text-[0.875rem] font-semibold text-accent-600">
                      <span class="size-2.5 rounded-full bg-accent-600" aria-hidden="true"></span><span class="sr-only sm:not-sr-only">Pinney</span>
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-2 text-[0.875rem] font-semibold text-navy">
                      <span class="size-2.5 rounded-full border-2 border-navy" aria-hidden="true"></span><span class="sr-only sm:not-sr-only">You</span>
                    </span>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr class="border-t-2 border-navy">
            <th scope="row" class="pt-5 pr-4 align-top text-[0.9375rem] font-semibold text-navy">What you keep</th>
            {routes.map((r) => (
              <td class:list={['px-2 pt-5 pb-6 align-top sm:px-3 md:px-6', r.n === 1 && 'bg-accent-50 rounded-b-2xl']}>
                <span class="numeral block text-[1.75rem] text-navy sm:text-[2.25rem] md:text-[2.75rem]">{r.pay}</span>
                <span class="mt-1 block text-[0.8125rem] text-muted">{r.payNote}</span>
              </td>
            ))}
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="mt-10 grid gap-6 border-t border-line pt-8 md:grid-cols-[14rem_1fr]" data-reveal>
      <p class="font-semibold text-navy">Self-Service is best for agents who want to:</p>
      <ul class="flex flex-wrap gap-x-7 gap-y-3 text-[0.9375rem]">
        {selfServiceIncludes.map((s) => (
          <li class="inline-flex items-center gap-2">
            <Icon name="hugeicons:tick-02" class="size-4 text-accent-600" aria-hidden="true" />{s}
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4" data-reveal>
      <p class="text-navy">Not sure which one fits this case?</p>
      <Button href="/submit#route-finder" variant="primary" size="sm" arrow>Use the route finder</Button>
    </div>
  </div>

  <!-- beyond one-at-a-time -->
  <div class="container-site mt-[clamp(5rem,9vw,8rem)]">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
      <figure class="relative order-last lg:order-first" data-reveal>
        <img src={img.team.src} srcset={img.team.srcset} sizes={img.team.sizes.main} width={img.team.width} height={img.team.height} alt={img.team.alt} loading="lazy" class="aspect-[4/3] w-full rounded-[1.75rem] object-cover" />
        <figcaption class="absolute right-5 bottom-5 left-5 flex items-center gap-3 rounded-xl bg-white/95 p-4 text-[0.875rem] text-navy backdrop-blur sm:right-auto">
          <Icon name="hugeicons:checkmark-circle-02" class="size-5 shrink-0 text-accent-600" aria-hidden="true" />
          Same 50/50 split, same white label, no lead cost.
        </figcaption>
      </figure>
      <div data-reveal>
        <p class="eyebrow">Beyond one-at-a-time referrals</p>
        <h3 class="h2 mt-5 max-w-[16ch]">We can work <strong>your leads for you.</strong></h3>
        <p class="mt-6 max-w-[56ch]">
          Referring case by case is the simplest way in. If you would rather hand us volume, we will do the outbound ourselves — give us a list of clients, quoted-but-not-sold prospects, or dormant accounts, and our team calls them as your life division, qualifies them, and works whatever is there.
        </p>
        <ul class="mt-8 space-y-4">
          {[
            'Send a list instead of a name — existing clients, old quotes, or a segment of your book',
            'We call, qualify, and generate the business; you approve the outreach first',
            'Or keep it simple and just refer them one at a time — your call, and you can do both',
          ].map((t) => (
            <li class="flex gap-3">
              <Icon name="hugeicons:arrow-right-02" class="mt-1 size-4 shrink-0 text-accent-600" aria-hidden="true" />
              <span>{t}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
