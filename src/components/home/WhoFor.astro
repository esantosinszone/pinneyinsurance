---
import { Icon } from 'astro-icon/components';
import Button from '../ui/Button.astro';
import { lanes } from '../../data/home';
import { img } from '../../data/site';
---
<section class="section bg-mist" id="who-its-for" aria-labelledby="who-title">
  <div class="container-site grid gap-14 lg:grid-cols-12 lg:gap-16">
    <!-- image column: bleeds to the edge on large screens -->
    <figure class="relative lg:col-span-5 lg:-ml-[max(0px,calc((100vw-var(--container-site))/2+2.5rem))]" data-reveal>
      <img
        src={img.owner.src}
        alt={img.owner.alt}
        width="1000"
        height="1250"
        loading="lazy"
        class="aspect-[4/3] w-full rounded-[1.75rem] object-cover lg:sticky lg:top-28 lg:aspect-[4/5] lg:rounded-l-none"
      />
    </figure>

    <div class="lg:col-span-7 lg:pt-6">
      <div data-reveal>
        <p class="eyebrow">Who we're for</p>
        <h2 id="who-title" class="h2 mt-5 max-w-[20ch]">You have life insurance clients. <strong>You don't want a back office.</strong></h2>
        <p class="lead mt-6 max-w-[58ch]">
          P&amp;C agencies, mortgage companies, and financial services firms with clients who need life insurance — and no interest in building the department it takes to place it.
        </p>
        <p class="mt-8 border-l-2 border-blue pl-5 text-[1.375rem] leading-snug font-light text-navy">
          You need customers who trust you. <strong class="font-semibold">We bring everything else.</strong>
        </p>
      </div>

      <ul class="mt-14 border-t border-line">
        {lanes.map((l, i) => (
          <li class="grid gap-3 border-b border-line py-8 sm:grid-cols-[3rem_1fr] sm:gap-6" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span class="inline-flex size-11 items-center justify-center rounded-full bg-white text-blue-600 shadow-[0_1px_0_var(--color-line)]">
              <Icon name={l.icon} class="size-5" aria-hidden="true" />
            </span>
            <div>
              <p class="label !text-blue-600">{l.kicker}</p>
              <h3 class="h3 mt-1.5">{l.title}</h3>
              <p class="mt-2 max-w-[58ch] text-[0.9375rem]">{l.body}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4" data-reveal>
        <p class="font-semibold text-navy">Sound like your shop?</p>
        <Button variant="outline" size="sm" arrow data-get-started>Set your firm up, or send one name</Button>
      </div>
    </div>
  </div>

  <!-- the thesis, set large -->
  <div class="container-site mt-[clamp(4.5rem,8vw,7rem)]" data-reveal>
    <blockquote class="mx-auto max-w-4xl text-center">
      <Icon name="hugeicons:quote-down" class="mx-auto size-9 text-blue" aria-hidden="true" />
      <p class="mt-6 text-[clamp(1.5rem,3.2vw,2.5rem)] leading-[1.2] font-light tracking-tight text-navy">
        Our goal isn't to turn you into a life insurance agency. <strong class="font-semibold">It's to make life insurance a repeatable line of the business you already run.</strong>
      </p>
    </blockquote>
  </div>
</section>
