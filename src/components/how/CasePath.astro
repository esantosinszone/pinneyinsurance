---
import { Icon } from 'astro-icon/components';
import SectionHeader from '../ui/SectionHeader.astro';
import { casePath, insideStages } from '../../data/how';
import { img } from '../../data/site';
---
<section class="section" id="case-path" aria-labelledby="path-title">
  <div class="container-site">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
      <SectionHeader class="lg:col-span-7" id="path-title" eyebrow="The path a referred case takes" title="Two lanes. <strong>Four of the six steps are ours.</strong>" />
      <p class="lead lg:col-span-5" data-reveal>
        Everything between your two boxes — the call, the sale, the application, the underwriting, the placement — runs on our side without pulling you back in.
      </p>
    </div>

    <!-- two-lane timeline: horizontal on desktop, vertical on small screens -->
    <ol class="relative mt-16 grid gap-0 lg:grid-cols-6" data-reveal>
      <span class="absolute top-0 bottom-0 left-[1.1875rem] w-px bg-line lg:top-[9.5rem] lg:right-[8%] lg:bottom-auto lg:left-[8%] lg:h-px lg:w-auto" aria-hidden="true"></span>
      {casePath.map((s, i) => {
        const you = s.lane === 'you';
        return (
          <li class:list={['relative grid grid-cols-[2.5rem_1fr] gap-5 pb-10 lg:block lg:pb-0 lg:text-center', you ? 'lg:pt-0' : 'lg:pt-[12rem]']}>
            <span
              class:list={[
                'relative z-10 inline-flex size-10 items-center justify-center rounded-full text-[0.8125rem] font-bold ring-[6px] ring-white lg:absolute lg:top-[8.25rem] lg:left-1/2 lg:-translate-x-1/2',
                you ? 'bg-blue text-white' : 'bg-navy text-white',
              ]}
            >
              {i + 1}
            </span>
            <div class:list={['lg:mx-auto lg:max-w-[12rem] lg:px-2', you ? 'lg:h-[7.25rem]' : '']}>
              <p class:list={['label', you ? '!text-blue-600' : '!text-navy']}>{you ? 'Your lane' : "Pinney's lane"}</p>
              <h3 class="h4 mt-1.5">{s.title}</h3>
              <p class="mt-1 text-[0.875rem] leading-snug text-muted">{s.note}</p>
              <p class="mt-3 inline-flex items-center gap-1.5 text-[0.75rem] font-semibold tracking-[0.06em] text-navy uppercase">
                <Icon name="hugeicons:clock-01" class="size-3.5 text-muted" aria-hidden="true" />{s.when}
              </p>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<section class="section bg-mist" id="inside-pinney" aria-labelledby="inside-title">
  <div class="container-site grid gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-40" data-reveal>
        <p class="eyebrow">What happens once a case reaches us</p>
        <h2 id="inside-title" class="h2 mt-5">Five stages. <strong>None of them yours.</strong></h2>
        <p class="mt-6 max-w-[48ch]">
          This is the part you would have to build a department to replicate. A named case manager owns it from arrival to payout.
        </p>
        <img src={img.office.src} alt={img.office.alt} width="1000" height="700" loading="lazy" class="mt-10 aspect-[3/2] w-full rounded-[1.5rem] object-cover" />
      </div>
    </div>

    <ol class="lg:col-span-7">
      {insideStages.map((s, i) => (
        <li class="grid grid-cols-[4.5rem_1fr] gap-4 border-t border-line-strong py-8 first:border-navy sm:grid-cols-[6rem_1fr]" data-reveal>
          <span class="numeral text-[2.75rem] text-blue sm:text-[3.5rem]" aria-hidden="true">0{i + 1}</span>
          <div>
            <h3 class="h3">{s.title}</h3>
            <p class="mt-2 max-w-[52ch] text-[0.9375rem]">{s.body}</p>
          </div>
        </li>
      ))}
      <li class="flex items-center gap-3 border-t border-line-strong pt-6 text-[0.875rem] font-semibold text-navy" data-reveal>
        <Icon name="hugeicons:calendar-03" class="size-5 text-blue-600" aria-hidden="true" />
        Typically four to six weeks to approval.
      </li>
    </ol>
  </div>
</section>
