---
import { Icon } from 'astro-icon/components';
import SectionHeader from '../ui/SectionHeader.astro';
import { buckets } from '../../data/how';
---
<section class="section" id="what-you-get" aria-labelledby="get-title">
  <div class="container-site">
    <SectionHeader
      id="get-title"
      eyebrow="The rest of what you get"
      title="Sorted by the three questions <strong>an agency owner actually asks.</strong>"
    />

    <div class="mt-16 space-y-[clamp(3.5rem,6vw,5rem)]">
      {buckets.map((b, bi) => (
        <div class="grid gap-8 border-t border-navy pt-8 lg:grid-cols-12 lg:gap-12" id={b.id}>
          <header class="lg:col-span-4" data-reveal>
            <p class="label !text-blue-600">0{bi + 1} · {b.label}</p>
            <h3 class="mt-3 text-[clamp(1.5rem,2.4vw,2rem)] leading-tight font-light tracking-tight text-navy">“{b.question}”</h3>
          </header>
          <ul class="grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:col-span-8">
            {b.items.map((it, i) => (
              <li class="flex gap-4" data-reveal style={`--reveal-delay:${(i % 2) * 60}ms`}>
                <Icon name={it.icon} class="mt-0.5 size-6 shrink-0 text-blue-600" aria-hidden="true" />
                <div>
                  <h4 class="h4">{it.title}</h4>
                  <p class="mt-1.5 text-[0.9375rem] text-muted">{it.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
