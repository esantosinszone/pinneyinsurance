---
// Sticky in-page navigation for the longer secondary pages. Active state is set by scripts/site.ts.
interface Props { items: { href: string; label: string }[]; label: string; }
const { items, label } = Astro.props;
---
<nav aria-label={label} class="sticky top-[var(--header-h)] z-40 border-b border-line bg-white/92 backdrop-blur-md" data-subnav>
  <div class="container-site">
    <ul class="-mx-2 flex gap-1 overflow-x-auto py-3 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
      {items.map((item) => (
        <li class="shrink-0">
          <a
            href={item.href}
            class="block rounded-full px-3.5 py-1.5 text-[0.8125rem] font-semibold whitespace-nowrap text-muted transition-colors duration-200 hover:bg-mist hover:text-navy data-[active]:bg-navy data-[active]:text-white"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
