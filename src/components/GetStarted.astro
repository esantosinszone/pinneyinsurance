---
import { Icon } from 'astro-icon/components';
import { contact, mail } from '../data/site';

const options = [
  {
    icon: 'hugeicons:handshake',
    title: 'Set my firm up to refer',
    body: "Opens an email to brokerage sales support with the subject and message already written — just drop in a day that works. We'll set your intro language, your named team, and how you get paid.",
    href: mail.setupFirm,
  },
  {
    icon: 'hugeicons:mail-send-01',
    title: 'Email the client information to us',
    body: "Opens a pre-formatted email with every field we need — name, email, phone, state, birthday, and coverage amount. Fastest option if you're between calls.",
    href: mail.clientInfo,
  },
  {
    icon: 'hugeicons:file-edit',
    title: 'Submit the client on the form',
    body: 'About two minutes, and it routes straight to a licensed advisor and a case manager.',
    href: '/submit#form',
  },
];
---
<dialog
  id="get-started"
  aria-labelledby="gs-title"
  class="m-auto w-[min(40rem,calc(100vw-2rem))] overflow-hidden rounded-2xl bg-white p-0 text-body shadow-[0_40px_80px_-30px_rgb(10_22_60/0.6)]"
>
  <div class="max-h-[calc(100dvh-2rem)] overflow-y-auto overscroll-contain" data-scroll-area="y">
  <div>
  <div class="relative px-6 pt-8 pb-6 sm:px-10 sm:pt-10">
    <button type="button" class="absolute top-4 right-4 inline-flex size-10 items-center justify-center rounded-full text-muted transition-colors hover:bg-mist hover:text-navy" data-dialog-close>
      <span class="sr-only">Close</span>
      <Icon name="hugeicons:cancel-01" class="size-5" aria-hidden="true" />
    </button>
    <p class="eyebrow">Get started</p>
    <h2 id="gs-title" class="h2 mt-4 !text-[2rem]">Three ways in.</h2>
    <p class="mt-3 text-muted">Pick whichever fits where you are right now. First call on any referral goes out within 24 hours.</p>
  </div>

  <ul class="border-t border-line">
    {options.map((o) => (
      <li class="border-b border-line">
        <a href={o.href} class="group flex gap-5 px-6 py-6 transition-colors duration-200 hover:bg-mist focus-visible:bg-mist sm:px-10" data-dialog-dismiss>
          <span class="mt-0.5 inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-accent-50 text-accent-600 transition-colors group-hover:bg-accent-600 group-hover:text-white">
            <Icon name={o.icon} class="size-5" aria-hidden="true" />
          </span>
          <span class="flex-1">
            <span class="h4 block text-navy">{o.title}</span>
            <span class="mt-1 block text-[0.9375rem] leading-relaxed text-muted">{o.body}</span>
          </span>
          <Icon name="hugeicons:arrow-right-02" class="mt-3 size-5 shrink-0 text-accent-600 transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true" />
        </a>
      </li>
    ))}
  </ul>

  <p class="px-6 py-5 text-[0.8125rem] text-muted sm:px-10">
    Partnership questions: <a class="link" href={mail.partnerships}>{contact.partnerships}</a> · <a class="link" href={contact.phone.href}>{contact.phone.label}</a>
  </p>
  </div>
  </div>
</dialog>
