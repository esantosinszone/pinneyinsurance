---

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  image: { src: string; srcset: string; sizes: Record<string, string>; width: number; height: number; alt: string };
}
const { eyebrow, title, lead, image } = Astro.props;
// computed by scripts/optimize-images.mjs from the photo's real aspect ratio
const sizes = image.sizes.hero;
---
<section class="on-dark brand-gradient grain relative isolate overflow-hidden pt-[calc(var(--header-h)+2.5rem)] pb-[clamp(3rem,6vw,4.5rem)] lg:pt-[calc(var(--header-h)+3.5rem)]">
  <div class="container-site relative z-10 grid items-center gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <p class="eyebrow hero-in" style="--d:0ms">{eyebrow}</p>
      <h1 class="display hero-in mt-5" style="--d:90ms" set:html={title} />
      <p class="lead hero-in mt-5 max-w-[54ch] !text-white/80" style="--d:190ms">{lead}</p>
      <div style="--d:280ms" class="hero-in mt-8 flex flex-wrap gap-3 empty:hidden"><slot name="actions" /></div>
    </div>
    <figure class="hero-media relative lg:col-span-5" style="--d:160ms">
      <img
        src={image.src}
        srcset={image.srcset}
        sizes={sizes}
        width={image.width}
        height={image.height}
        alt={image.alt}
        class="aspect-[16/10] w-full rounded-[1.5rem] object-cover sm:aspect-[2/1] lg:aspect-[1/1] lg:rounded-[1.75rem] shadow-[0_40px_80px_-40px_rgb(0_0_0/0.7)]"
        fetchpriority="high"
      />
      <span class="absolute -bottom-5 -left-5 -z-10 hidden size-40 lg:block rounded-[1.75rem] border border-white/20" aria-hidden="true"></span>
    </figure>
  </div>
</section>
